# Security Configuration
#CUSTOM_DOMAIN="your-domain.com" # Your custom domain for CORS
#ENVIRONMENT="prod" # Options: dev, staging, prod

# Feature flags

# Cloudflare Credentials (Required for manual deployment via `bun run deploy`)
# These are automatically provided when using "Deploy to Cloudflare" button
# Get these from: https://dash.cloudflare.com/profile/api-tokens
#CLOUDFLARE_API_TOKEN="" # API token with Account-level permissions (see README for required permissions)
#CLOUDFLARE_ACCOUNT_ID="" # Your Cloudflare account ID

# Cloudflare Artifacts read-only "Repo" viewer.
# The viewer proxies Cloudflare's Artifacts REST API, which requires a
# Cloudflare API token with Artifacts *read* permission. By default the proxy
# reuses CLOUDFLARE_API_TOKEN above; set ARTIFACTS_API_TOKEN to use a dedicated,
# least-privilege token instead. (The ARTIFACTS binding's repo tokens are for
# the git remote and are NOT accepted by the REST API.)
#ARTIFACTS_API_TOKEN=""
# ARTIFACTS_NAMESPACE is set as a plain var in wrangler.jsonc; override here for
# local dev if needed.
#ARTIFACTS_NAMESPACE="vibesdk-production"

# Essential Secrets:
#CLOUDFLARE_AI_GATEWAY_TOKEN="" # If this has read and edit permissions, the AI Gateway will be created automatically. run is required at the least

# Provider specific secrets:
#ANTHROPIC_API_KEY=""
#OPENAI_API_KEY=""
#GOOGLE_AI_STUDIO_API_KEY=""
#OPENROUTER_API_KEY="default" 
#GROQ_API_KEY="default" 
 
# Optional: the model Think builds with, as an AI Gateway model id
# (`<provider>/<model>`). Unset means google-ai-studio/gemini-3.6-flash.
# The provider decides which <PROVIDER>_API_KEY is sent, falling back to the
# gateway token. Start a new app after changing it: an existing app keeps the
# model it was created with.
#THINK_MODEL_ID="workers-ai/@cf/moonshotai/kimi-k3"
#THINK_MODEL_ID="openrouter/moonshotai/kimi-k3"

# Optional: real stock photos for generated sites (Think's `search_images` tool).
# Free key from https://www.pexels.com/api/. Without it, the agent falls back
# to typographic/illustrative/CSS-only treatments instead of real photography.
#PEXELS_API_KEY=""

# Stuff for Oauths:
#GOOGLE_CLIENT_SECRET=""
#GOOGLE_CLIENT_ID="" 

# GitHub OAuth
#GITHUB_CLIENT_ID=""
#GITHUB_CLIENT_SECRET=""

# Github Export OAuth
# GITHUB_EXPORTER_CLIENT_SECRET=""
# GITHUB_EXPORTER_CLIENT_ID=""

# Secrets for various internal services of this platform
# JWT_SECRET is generated automatically during Deploy to Cloudflare.
#JWT_SECRET=""

# AI Gateway URL Override (Leave as-is if not going to set it)
#CLOUDFLARE_AI_GATEWAY_URL=""

# Cloudflare API Key and Account ID. This is important
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""